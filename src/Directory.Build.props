<Project>
  <!--
    Shared settings for the shipped package.

    Package validation compares the package against the release already published on nuget.org
    (the baseline package is downloaded from the live feed) and fails the pack on any API or
    target-framework break. CI also validates against the latest 1.3.x:
      dotnet pack -c Release -p:GeneratePackageOnBuild=false -p:PackageValidationBaselineVersion=1.3.1
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == ''">2.0.0</PackageValidationBaselineVersion>
    <!-- Also validate netstandard2.0 vs net8.0/net10.0 surfaces inside the same package. -->
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
  </PropertyGroup>

  <!--
    Known false positives for one baseline go in CompatibilitySuppressions.<baseline version>.xml next to the
    project and apply only when validating against that version.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/CompatibilitySuppressions.$(PackageValidationBaselineVersion).xml')">
    <ApiCompatSuppressionFile Include="$(MSBuildProjectDirectory)/CompatibilitySuppressions.$(PackageValidationBaselineVersion).xml" />
  </ItemGroup>
</Project>
